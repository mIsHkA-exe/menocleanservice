<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<script>
			document.documentElement.classList.add('js');
		</script>

		<title>
			{% block title %}MENO CLEAN SERVICES
			{% endblock %}
		</title>
		<meta name="description" content="{% block meta_description %}MENO CLEAN SERVICES, entreprise de nettoyage professionnel en Île-de-France.{% endblock %}">
		<meta name="robots" content="{% block meta_robots %}index, follow{% endblock %}">
		<link rel="canonical" href="{% block canonical %}{{ app.request.schemeAndHttpHost ~ app.request.pathInfo }}{% endblock %}">

		<link
		rel="icon" href="{{ asset('images/main-logo.png') }}">

		{# Polices de la charte graphique #}
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link
		href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
		{# Aperçu lors d'un partage (Facebook, LinkedIn, WhatsApp) #}
		<meta property="og:type" content="website">
		<meta property="og:site_name" content="MENO CLEAN SERVICES">
		<meta property="og:locale" content="fr_FR">
		<meta property="og:title">
		content="
		{% block og_title %}
			{{ block('title') }}
		{% endblock %}"
		<meta property="og:description">
		content="
		{% block og_description %}
			{{ block('meta_description') }}
		{% endblock %}"
		<meta property="og:url" content="{{ app.request.schemeAndHttpHost ~ app.request.pathInfo }}">
		<meta
		property="og:image" content="{{ app.request.schemeAndHttpHost ~ asset('images/main-logo.png') }}">

		{# Twitter / X #}
		<meta name="twitter:card" content="summary_large_image">
		<meta name="twitter:title" content="{{ block('og_title') }}">
		<meta name="twitter:description" content="{{ block('og_description') }}"> 
		
		{% block head_extra %}
		{% endblock %}


		{% block javascripts %}
			{{ importmap('app') }}
		{% endblock %}

		{{ include('partials/_schema_organization.html.twig') }}
	</head>
	<body>
		{% block overlay %}{% endblock %}
		<a class="skip-link" href="#contenu">Aller au contenu principal</a>

		{{ include('partials/_icons.html.twig') }}
		{{ include('partials/_header.html.twig', { headerSolid: headerSolid|default(false) }) }}

		<main id="contenu" data-controller="reveal"> {% block body %}{% endblock %}
			</main>

			{{ include('partials/_footer.html.twig') }}
			{{ include('partials/_back_to_top.html.twig') }}

		</body>
	</html>
