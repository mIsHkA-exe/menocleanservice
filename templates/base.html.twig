<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<script>
			document.documentElement.classList.add('js');
		</script>

		<title>
			{% block title %}MENO CLEAN SERVICES
			{% endblock %}
		</title>
		<meta name="description" content="{% block meta_description %}MENO CLEAN SERVICES, entreprise de nettoyage professionnel en Île-de-France.{% endblock %}">
		<meta name="robots" content="{% block meta_robots %}index, follow{% endblock %}">
		<link rel="canonical" href="{% block canonical %}{{ app.request.schemeAndHttpHost ~ app.request.pathInfo }}{% endblock %}">

		{# Icônes : emblème du logo recadré (R01) #}
		<link rel="icon" type="image/png" sizes="48x48" href="{{ asset('images/favicon-48.png') }}">
		<link rel="apple-touch-icon" href="{{ asset('images/apple-touch-icon.png') }}">

		{# Polices de la charte graphique : hébergées localement (F03), déclarées dans app.css.
		   Préchargement des deux polices visibles dès l'ouverture ; crossorigin est obligatoire pour une police. #}
		<link rel="preload" href="{{ asset('fonts/bricolage-grotesque-latin-opsz-normal.woff2') }}" as="font" type="font/woff2" crossorigin>
		<link rel="preload" href="{{ asset('fonts/inter-latin-wght-normal.woff2') }}" as="font" type="font/woff2" crossorigin>
		{# Aperçu lors d'un partage (Facebook, LinkedIn, WhatsApp) #}
		<meta property="og:type" content="website">
		<meta property="og:site_name" content="MENO CLEAN SERVICES">
		<meta property="og:locale" content="fr_FR">
		{# Un seul élément par balise : l'attribut content reste DANS la balise (C07).
		   trim retire les retours à la ligne laissés par les blocs title et meta_description. #}
		<meta property="og:title" content="{% block og_title %}{{ block('title')|trim }}{% endblock %}">
		<meta property="og:description" content="{% block og_description %}{{ block('meta_description')|trim }}{% endblock %}">
		<meta property="og:url" content="{{ app.request.schemeAndHttpHost ~ app.request.pathInfo }}">
		<meta property="og:image" content="{{ app.request.schemeAndHttpHost ~ asset('images/main-logo.jpg') }}">
		<meta property="og:image:width" content="1200">
		<meta property="og:image:height" content="800">

		{# Twitter / X #}
		<meta name="twitter:card" content="summary_large_image">
		<meta name="twitter:title" content="{{ block('og_title') }}">
		<meta name="twitter:description" content="{{ block('og_description') }}"> 
		
		{% block head_extra %}
		{% endblock %}


		{% block javascripts %}
			{{ importmap('app') }}
		{% endblock %}

		{{ include('partials/_schema_organization.html.twig') }}
	</head>
	{# section-link : liens internes à la page sans rechargement (en-tête, pied, boutons) #}
	<body data-controller="section-link" data-action="click->section-link#suivre">
		{% block overlay %}{% endblock %}
		<a class="skip-link" href="#contenu">Aller au contenu principal</a>

		{{ include('partials/_icons.html.twig') }}
		{{ include('partials/_header.html.twig', { headerSolid: headerSolid|default(false) }) }}

		<main id="contenu" data-controller="reveal"> {% block body %}{% endblock %}
			</main>

			{{ include('partials/_footer.html.twig') }}
			{{ include('partials/_back_to_top.html.twig') }}

		</body>
	</html>
