<section class="section section--alt" id="avis">
	<div class="container">
		<div class="section-head center reveal">
			<span class="eyebrow">Ils nous font confiance</span>
			<h2>L'avis de nos clients</h2>
		</div>

		<div class="testimonials reveal" data-controller="carousel" data-action="mouseenter->carousel#stop mouseleave->carousel#start">

			<div class="t-track">
				<div class="t-slides" data-carousel-target="slides" data-action="touchstart->carousel#touchStart touchend->carousel#touchEnd">

					<div class="t-slide" data-carousel-target="slide">
						<div class="t-card">
							<div class="t-stars">
								{% for i in 1..5 %}
									<svg width="18" height="18" aria-hidden="true"><use href="#icon-star"/></svg>
								{% endfor %}
							</div>
							<p class="t-quote">« Une équipe sérieuse et toujours à l'heure. Nos parties communes n'ont jamais été aussi propres, et le suivi est irréprochable. »</p>
							<div class="t-person">
								<span class="t-avatar">CB</span>
								<div>
									<b>Camille B</b>
									<span>Syndic — LE CHAMBLAIN Melun</span>
								</div>
							</div>
						</div>
					</div>

					<div class="t-slide" data-carousel-target="slide">
						<div class="t-card">
							<div class="t-stars">
								{% for i in 1..5 %}
									<svg width="18" height="18" aria-hidden="true"><use href="#icon-star"/></svg>
								{% endfor %}
							</div>
							<p class="t-quote">« Devis clair, intervention rapide et un rendu impeccable pour notre boutique. Je recommande MENO CLEAN SERVICES sans hésiter. »</p>
							<div class="t-person">
								<span class="t-avatar">SS</span>
								<div>
									<b>Sarah S</b>
									<span>Gérant — Lissac l'Opticien Bezons</span>
								</div>
							</div>
						</div>
					</div>

					<div class="t-slide" data-carousel-target="slide">
						<div class="t-card">
							<div class="t-stars">
								{% for i in 1..5 %}
									<svg width="18" height="18" aria-hidden="true"><use href="#icon-star"/></svg>
								{% endfor %}
							</div>
							<p class="t-quote">« Nous confions l'entretien de nos bureaux à MENO depuis juin 2026. Ponctualité, discrétion et qualité constante : exactement ce qu'il nous fallait. »</p>
							<div class="t-person">
								<span class="t-avatar">YT</span>
								<div>
									<b>Yannick T</b>
									<span>Expert comptable — TNG-associe</span>
								</div>
							</div>
						</div>
					</div>

				</div>
			</div>

			<div class="t-controls">
				<button type="button" class="t-arrow t-arrow--prev" aria-label="Témoignage précédent" data-action="click->carousel#previous">
					<svg width="16" height="16" class="icon-flip-x" aria-hidden="true"><use href="#icon-arrow"/></svg>
				</button>

				<div class="t-dots">
					{% for i in 0..2 %}
						<button type="button" class="t-dot{{ i == 0 ? ' is-active' }}" aria-label="Voir le témoignage {{ i + 1 }}" data-carousel-target="dot" data-action="click->carousel#goTo" data-carousel-index-param="{{ i }}"></button>
					{% endfor %}
				</div>

				<button type="button" class="t-arrow t-arrow--next" aria-label="Témoignage suivant" data-action="click->carousel#next">
					<svg width="16" height="16" class="icon-flip-x" aria-hidden="true"><use href="#icon-arrow"/></svg>
				</button>
			</div>
		</div>
	</div>
</section>
